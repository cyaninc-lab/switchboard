{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchboard",
  "version": "0.1.6",
  "identifier": "org.cyaninc.switchboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Switchboard",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/switchboard-daemon"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NkQyREU5RjAxQjUxOTgKUldTWVVSdnc2UzF0SjdvZ3laenNlSTZRUkhMQWR2OUMyRmtBaGU3TzFsQTJJZG00QlNkYTNpZTkK",
      "endpoints": [
        "https://github.com/cyaninc-lab/switchboard-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
